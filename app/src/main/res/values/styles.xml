<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full‑screen modal bottom sheet -->
    <style name="Theme.MPM.BottomSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MPM.FullScreenBottomSheet</item>
    </style>

    <style name="Widget.MPM.FullScreenBottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <!-- Hide the peek height -->
        <item name="behavior_peekHeight">0dp</item>
        <!-- Allow full expansion beyond content height -->
        <item name="behavior_fitToContents">false</item>
        <!-- When expanded, offset 0 = flush at the top -->
        <item name="behavior_expandedOffset">0dp</item>
    </style>

    <style name="FullScreenDialog" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="NutritionValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="NutritionValueSmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#555</item>
    </style>

</resources>