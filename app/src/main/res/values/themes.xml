<resources>
    <style name="TextAppearance.App.HeadlineSmall.CustomColor" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/black</item> <!-- Example: Use primary color -->
    </style>

    <style name="TextAppearance.App.TitleMedium.CustomColor" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextAppearance.App.BodyLarge.CustomColor" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextAppearance.App.BodyMedium.CustomColor" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/grey_dark</item>
    </style>

    <style name="TextAppearance.App.BodySmall.CustomColor" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/grey_dark</item>
    </style>

    <style name="TextAppearance.App.LabelLarge.CustomColor" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextAppearance.App.LabelMedium.CustomColor" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item> <!-- Adjust corner radius as needed -->
    </style>

    <style name="SectionTitleTextView" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item> <!-- Consistent spacing -->
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item> <!-- Or Headline6, etc. -->
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Base application theme. -->
    <style name="Theme.PokemonMealtimeMasters" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item> <!-- Example color -->
        <item name="colorPrimaryVariant">@color/black</item> <!-- Example color -->
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item> <!-- Example color -->
        <item name="colorSecondaryVariant">@color/teal_200</item> <!-- Example color -->
        <item name="colorOnSecondary">@color/black</item>

        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall.CustomColor</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium.CustomColor</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge.CustomColor</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium.CustomColor</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall.CustomColor</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge.CustomColor</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.LabelMedium.CustomColor</item>

    </style>

    <!-- Custom Dialog Theme -->
    <style name="Theme_MPM_Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <!-- You can keep or change the colorPrimary -->
        <item name="colorPrimary">@color/purple_500</item>

        <!-- Apply the custom shape appearance for rounded corners -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Dialog</item>
    </style>

    <!-- Specific style for Bottom Sheets -->
    <style name="Theme.MPM.BottomSheet" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MPM.BottomSheet</item>
    </style>

    <style name="Widget.MPM.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MPM.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.MPM.BottomSheet" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.MaterialComponents.Headline6</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.MaterialComponents.Subtitle1</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.MaterialComponents.Body1</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.MaterialComponents.Body2</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.MaterialComponents.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.MaterialComponents.Button</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.MaterialComponents.Caption</item>
    </style>

</resources>