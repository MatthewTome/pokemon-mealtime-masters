<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
    style="@style/Widget.Material3.BottomSheet.Modal">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/nutrition_details"
        app:navigationIcon="@drawable/ic_rounded_close_24" />

    <!-- ScrollView for Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Servings Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_servings"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/servings">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_servings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text=""/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Calories Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_calories"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/calories_kcal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_calories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    tools:text=""/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Protein Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_protein"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/protein_g">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_protein"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    tools:text=""/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Total Sugars Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_total_sugars"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="@string/total_sugars_g">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_total_sugars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    tools:text=""/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Add Meal Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add_meal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/add_meal"
                app:icon="@drawable/ic_rounded_check_circle_24" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>