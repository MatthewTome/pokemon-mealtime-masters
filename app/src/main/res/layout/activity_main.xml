<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_gradient">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:backgroundTint="@android:color/transparent"
        android:title="@string/title"
        android:titleTextColor="@android:color/black"
        app:menu="@menu/main_menu"/>

    <!-- Scrollable content under the AppBar -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Pokémon Display -->
                <ImageView
                    android:id="@+id/image_pokemon_sprite"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"
                    android:contentDescription="@string/content_desc_pokemon_partner"
                    tools:src="@drawable/pokeball_silhouette" /> <!-- Placeholder -->

                <!-- Daily Progress Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_progress_title"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    style="?attr/textAppearanceHeadlineSmall"/>

                <!-- Calories Progress -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calories_label"
                        style="?attr/textAppearanceTitleMedium"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/prog_calories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:trackThickness="12dp"
                        app:trackCornerRadius="100dp"
                        app:indicatorColor="@color/teal_200"
                        app:trackColor="@color/grey_light"
                        android:progress="50"
                        tools:progress="50"/>

                    <TextView
                        android:id="@+id/text_calories_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="2dp"
                        tools:text="1000 / 2000 kcal"
                        style="?attr/textAppearanceBodySmall"/>
                </LinearLayout>

                <!-- Protein Progress -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protein_label"
                        style="?attr/textAppearanceTitleMedium"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/prog_protein"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:trackThickness="12dp"
                        app:trackCornerRadius="100dp"
                        app:indicatorColor="@color/protein_color"
                        app:trackColor="@color/grey_light"
                        android:progress="75"
                        tools:progress="75"/>

                    <TextView
                        android:id="@+id/text_protein_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="2dp"
                        tools:text="38 / 50 g"
                        style="?attr/textAppearanceBodySmall"/>
                </LinearLayout>

                <!-- Total Sugars Progress -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_sugars_label"
                        style="?attr/textAppearanceTitleMedium"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/prog_total_sugars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:trackThickness="12dp"
                        app:trackCornerRadius="100dp"
                        app:indicatorColor="@color/sugar_color"
                        app:trackColor="@color/grey_light"
                        android:progress="25"
                        tools:progress="25"/>

                    <TextView
                        android:id="@+id/text_sugars_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="2dp"
                        tools:text="23 / 90 g"
                        style="?attr/textAppearanceBodySmall"/>
                </LinearLayout>

                <!-- Vitamin Checkbox -->
                <CheckBox
                    android:id="@+id/checkbox_vitamin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"
                    android:text="@string/vitamin_checkbox_label"
                    style="?attr/textAppearanceBodyLarge"/>

                <!-- Divider -->
                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:dividerColor="@color/grey_light"/>

                <!-- Logged Meals Section Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/todays_logged_meals"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    style="?attr/textAppearanceHeadlineSmall"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/logged_meals_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </ScrollView>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_meal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/log_meal"
        app:srcCompat="@android:drawable/ic_input_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>